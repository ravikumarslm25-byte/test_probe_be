{
  "name": "testprobe-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/seed/seed.js",
    "check-db": "node src/seed/check.js",
    "prod:start": "mkdir -p logs && NODE_ENV=production forever start --uid testprobe-api --minUptime 1000 --spinSleepTime 1000 -a -o \"$PWD/logs/out.log\" -e \"$PWD/logs/err.log\" src/index.js",
    "prod:restart": "forever restart testprobe-api",
    "prod:stop": "forever stop testprobe-api",
    "prod:logs": "tail -n 100 -f logs/out.log logs/err.log",
    "prod:status": "forever list"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "morgan": "^1.10.0",
    "zod": "^3.23.8",
    "ws": "^8.18.0"
  }
}
